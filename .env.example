# Neon PostgreSQL (pooled connection string)
DATABASE_URL=

# Vercel Blob — media uploads for blog images
BLOB_READ_WRITE_TOKEN=

# Neon Auth (Managed Better Auth)
# Branch Auth URL from the Neon Console → Auth → Configuration
NEON_AUTH_BASE_URL=
# Secret for signing the session cookie (openssl rand -base64 32, 32+ chars)
NEON_AUTH_COOKIE_SECRET=
# Public, same-origin auth proxy path used by the browser client
VITE_NEON_AUTH_URL=/api/auth
